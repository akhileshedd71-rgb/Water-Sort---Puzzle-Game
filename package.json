{
  "name": "hue-water-sort",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/offline.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsx --test tests/engine.test.ts",
    "test:browser": "node --import tsx tests/browser.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && node scripts/android-build.mjs"
  },
  "dependencies": {
    "@capacitor/android": "7.6.9",
    "@capacitor/core": "7.6.9",
    "@fontsource/dm-sans": "5.2.8",
    "@fontsource/outfit": "5.2.8",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.9",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.58.0",
    "tsx": "^4.19.0",
    "typescript": "~5.7.3",
    "vite": "^6.1.0"
  }
}
